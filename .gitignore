# Machine-local editor configuration; shared tasks/launch/extensions remain eligible for version control
.vscode/settings.json

# Runtime crash and local Redis persistence artifacts
hs_err_pid*.log
replay_pid*.log
dump.rdb

# Machine-local deployment configuration; keep only the reviewed example.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Maven Versions Plugin backup files
*.versionsBackup
