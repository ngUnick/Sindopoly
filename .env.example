# Optional overrides for the DEVELOPMENT-ONLY Docker Compose stack.
# These values are intentionally local-only and are not valid production secrets.
SINDOPOLY_DEV_DB_ROOT_PASSWORD=replace-for-local-development
SINDOPOLY_DEV_DB_NAME=sindopoly
SINDOPOLY_DEV_DB_USERNAME=sindopoly_dev
SINDOPOLY_DEV_DB_PASSWORD=replace-for-local-development
SINDOPOLY_DEV_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
SINDOPOLY_DEV_API_BASE_URL=http://localhost:8080
